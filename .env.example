# =============================================================================
# FlashX API environment
# =============================================================================
# Local:  cp .env.example .env, then fill SECRET_KEY, DATABASE_URL and the
#         Cloudinary keys. Every other value already has a working default.
# Vercel: add the same keys in Project Settings > Environment Variables.
#         Values marked [PROD] show what to use there.
# Never commit a real .env.
#
# Set automatically by Vercel (do not add them yourself):
#   VERCEL, VERCEL_URL, VERCEL_BRANCH_URL, VERCEL_PROJECT_PRODUCTION_URL
#   Their hostnames are added to ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS.

# --- Core --------------------------------------------------------------------
# [PROD] config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development
# Development defaults to True, production is always False.
DEBUG=True
# Required. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Comma separated hostnames. [PROD] your custom domain, e.g. api.flashx.app
# Add your computer's LAN IP here when testing on a physical phone.
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Admin path. [PROD] change to something not guessable, keep the trailing slash.
ADMIN_URL=admin/
TIME_ZONE=Africa/Nairobi
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Database (PostgreSQL 14+) -----------------------------------------------
# Required. [PROD] Neon via Vercel sets DATABASE_URL (pooled) automatically.
# Run migrations against DATABASE_URL_UNPOOLED (see README, Deploy to Vercel).
DATABASE_URL=postgres://flashx:flashx@localhost:5432/flashx
# Seconds to reuse a connection; health checks drop stale ones. 0 closes it after each request.
DB_CONN_MAX_AGE=60
# Production settings only. Keep True behind a transaction-mode pooler
# (Neon -pooler, PgBouncer, Supabase). False only for a direct connection.
DB_DISABLE_SERVER_SIDE_CURSORS=True

# --- Cloudinary (the secret stays on the server, never in the Flutter app) ---
# Dashboard > Settings > API Keys. Blank keys disable uploads (HTTP 503).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Top-level folder for every upload.
CLOUDINARY_ROOT_FOLDER=flashx
# Re-read file metadata from the Admin API after a direct upload (recommended).
CLOUDINARY_VERIFY_WITH_ADMIN_API=True
# How long signed upload parameters stay valid, in seconds.
CLOUDINARY_SIGNATURE_TTL_SECONDS=3600

# --- JWT ---------------------------------------------------------------------
# Access token lifetime in minutes, refresh token lifetime in days.
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=30
# Blank uses SECRET_KEY. Set a separate value (32+ chars) to rotate tokens
# without rotating SECRET_KEY.
JWT_SIGNING_KEY=

# --- Scheduled jobs ----------------------------------------------------------
# Vercel Cron calls /api/cron/maintenance/ with "Authorization: Bearer <CRON_SECRET>".
# Blank disables the endpoint (HTTP 503).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=

# --- CORS / CSRF (browser origins only; the mobile app is not affected) ------
# Development settings only: allow every origin.
CORS_ALLOW_ALL_ORIGINS=True
# Comma separated full origins, e.g. https://admin.flashx.app
CORS_ALLOWED_ORIGINS=
# Comma separated full origins for the admin behind a custom domain,
# e.g. https://api.flashx.app
CSRF_TRUSTED_ORIGINS=

# --- HTTPS (production settings only) ----------------------------------------
SECURE_SSL_REDIRECT=True
# HSTS max-age in seconds. Use 3600 for the first deploy, then 31536000.
SECURE_HSTS_SECONDS=31536000

# --- Email (password reset) --------------------------------------------------
# Console backend prints emails to the terminal.
# [PROD] django.core.mail.backends.smtp.EmailBackend plus the SMTP values below.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=FlashX <no-reply@flashx.app>
# Link sent in reset emails; {uid} and {token} are filled in.
PASSWORD_RESET_URL=flashx://reset-password?uid={uid}&token={token}

# --- Media and content limits ------------------------------------------------
# Bytes: 15 MB images, 150 MB videos.
MEDIA_IMAGE_MAX_BYTES=15728640
MEDIA_VIDEO_MAX_BYTES=157286400
POST_MAX_MEDIA_ITEMS=10
# Video length limits in seconds.
POST_VIDEO_MAX_SECONDS=600
STORY_VIDEO_MAX_SECONDS=60
REEL_MAX_SECONDS=180
MESSAGE_VIDEO_MAX_SECONDS=300
STORY_LIFETIME_HOURS=24
# A user counts as online if seen within this many seconds.
ONLINE_WINDOW_SECONDS=300
# Hide content automatically after this many open reports. 0 turns it off.
REPORT_AUTO_HIDE_THRESHOLD=0

# --- Rate limits (number/sec|min|hour|day) -----------------------------------
THROTTLE_ANON=60/min
THROTTLE_USER=600/min
THROTTLE_AUTH=10/min
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_UPLOAD=60/hour
THROTTLE_CONTENT_CREATE=60/hour
THROTTLE_MESSAGE_SEND=120/min
THROTTLE_REPORT=30/hour
